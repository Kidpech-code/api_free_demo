# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s

# ── Redis ────────────────────────────────────────────────────────────────────
# Railway injects REDIS_URL automatically when you add a Redis plugin.
# The application uses redis.ParseURL() so both redis:// and rediss:// (TLS)
# schemes are supported out of the box — no additional config required.
#
# For local development, you can use either form:
#   REDIS_URL=redis://localhost:6379
#   REDIS_URL=redis://:mypassword@localhost:6379/0
#
# If REDIS_URL is not set, the individual vars below are used instead:
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: openssl rand -hex 32
# The app will refuse to start in production if this is unset or < 32 chars.
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=info

# DATA_TTL controls how long sandbox data lives in Redis (default: 72h)
DATA_TTL=72h

# Rate limiting: max requests per window per authenticated user
RATE_LIMIT=100
RATE_WINDOW=1m

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Leave empty to allow all (sandbox/dev only).
# Example: https://myapp.railway.app,https://myapp.com
CORS_ALLOWED_ORIGINS=

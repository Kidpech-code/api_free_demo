# Railway Environment Variables Template
# Copy these to your Railway project Settings → Variables

PORT=8080
APP_ENV=production
APP_NAME=freeapi

# Database (use Railway's variable reference)
DB_DRIVER=postgres
DB_DSN=${{Postgres.DATABASE_URL}}

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_RANDOM_STRING
JWT_ISSUER=freeapi.kidpech.app

# Domain & CORS
BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
ALLOWED_HOSTS=${{RAILWAY_PUBLIC_DOMAIN}},freeapi.kidpech.app
CORS_ORIGINS=https://${{RAILWAY_PUBLIC_DOMAIN}},https://freeapi.kidpech.app

# Redis (optional - leave empty to use in-memory rate limiter)
REDIS_ADDR=

# Features
ALLOW_REGISTRATION=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=60

# Monitoring (optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=true
